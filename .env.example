# Krishi AI - Environment Variables
# Copy this file to .env.local and fill in your API keys

# AI API Keys (at least one recommended for full functionality)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: privacy-respecting analytics endpoint (Plausible / Umami).
# Leave empty to disable analytics entirely — the app is fully functional
# without it. Users can also enable it in-app (Profile → Settings).
# NEXT_PUBLIC_ANALYTICS_URL=https://plausible.io

# Optional: Vercel deployment
# VERCEL_URL=krishiai.live
